# Discord bot token (keep secret; never commit the real value)
DISCORD_TOKEN=

# Prefix command retained from 102026: .tts <text>
KTT_COMMAND_PREFIX=.

# Optional 24/7 voice connection. Leave 0/blank to disable.
KTT_VOICE_CHANNEL_ID=0
KTT_VOICE_SELF_DEAF=1
KTT_VOICE_KEEPALIVE_SECONDS=45

# Runtime limits
KTT_MAX_MUSIC_QUEUE=100
KTT_MAX_TTS_CHARS=500
KTT_LOG_LEVEL=INFO
KTT_SYNC_COMMANDS_ON_START=1
